{% doc %}
  Applies instance-specific wholesale colours, typography and spacing.
  @param {section} section - The section containing the design settings.
  @param {boolean} [location_spacing] - Use the existing Locations padding controls.
{% enddoc %}
{{ 'hic-wholesale.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign wholesale_scheme = section.settings.color_scheme | default: section.settings.section_colors
  assign button_contrast = wholesale_scheme.settings.button | color_contrast: wholesale_scheme.settings.button_label
  assign link_contrast = wholesale_scheme.settings.secondary_button_label | color_contrast: wholesale_scheme.settings.background

  comment
    Resolve empty overrides before Theme Editor colour substitution in style.
    Keep the setting output inside style so populated colours still preview live.
  endcomment
  assign color_overrides = 'background_color,text_color,button_color,button_text_color,heading_color,accent_color,card_color,border_color' | split: ','
  assign active_overrides = ''
  for color_id in color_overrides
    if section.settings[color_id] != blank
      assign active_overrides = active_overrides | append: color_id | append: ','
    endif
  endfor
  assign active_overrides = active_overrides | split: ','
  assign use_scheme_button_contrast = true
  if active_overrides contains 'button_color' or active_overrides contains 'button_text_color'
    assign use_scheme_button_contrast = false
  endif
-%}
{%- style -%}
  #Wholesale-{{ section.id }} {
    --page-width: {% if settings.fluid %}100%{% else %}{{ settings.page_width | divided_by: 10.0 }}rem{% endif %};
    {% if active_overrides contains 'background_color' %}
      --color-background: {{ section.settings.background_color.red }}, {{ section.settings.background_color.green }}, {{ section.settings.background_color.blue }};
      --gradient-background: {{ section.settings.background_color }};
      --color-secondary-button: var(--color-background);
    {% endif %}
    {% if active_overrides contains 'text_color' %}
      --color-foreground: {{ section.settings.text_color.red }}, {{ section.settings.text_color.green }}, {{ section.settings.text_color.blue }};
    {% endif %}
    {% if button_contrast < 4.5 and use_scheme_button_contrast %}
      --color-button: var(--color-foreground);
      --color-button-text: var(--color-background);
    {% endif %}
    {% if active_overrides contains 'button_color' %}
      --color-button: {{ section.settings.button_color.red }}, {{ section.settings.button_color.green }}, {{ section.settings.button_color.blue }};
    {% endif %}
    {% if active_overrides contains 'button_text_color' %}
      --color-button-text: {{ section.settings.button_text_color.red }}, {{ section.settings.button_text_color.green }}, {{ section.settings.button_text_color.blue }};
    {% endif %}
    {% if link_contrast < 4.5 %}
      --color-secondary-button-text: var(--color-foreground);
      --color-link: var(--color-foreground);
    {% endif %}
    {% if active_overrides contains 'heading_color' %}
      --ws-heading: {{ section.settings.heading_color }};
      --color-secondary-button-text: {{ section.settings.heading_color.red }}, {{ section.settings.heading_color.green }}, {{ section.settings.heading_color.blue }};
    {% endif %}
    {% if active_overrides contains 'accent_color' %}
      --ws-accent: {{ section.settings.accent_color }};
    {% endif %}
    {% if active_overrides contains 'card_color' %}
      --ws-card: {{ section.settings.card_color }};
    {% endif %}
    {% if active_overrides contains 'border_color' %}
      --ws-border: {{ section.settings.border_color }};
    {% endif %}
    --ws-heading-size: {{ section.settings.heading_size | divided_by: 10.0 }}rem;
    --ws-heading-mobile: {{ section.settings.heading_size_mobile | divided_by: 10.0 }}rem;
    --ws-card-heading: {{ section.settings.card_heading_size | divided_by: 10.0 }}rem;
    --ws-body-size: {{ section.settings.body_size | divided_by: 10.0 }}rem;
    --ws-radius: {{ section.settings.corner_radius }}px;
    --ws-gap: {{ section.settings.card_gap }}px;
    --ws-columns: {{ section.settings.columns_desktop | default: 3 }};
    --ws-align: {{ section.settings.text_alignment | remove: 'ts-text-' }};
    --ws-mobile-align: {{ section.settings.text_alignment_mobile }};
    --ws-justify: {{ section.settings.text_alignment | remove: 'ts-text-' | replace: 'left', 'flex-start' | replace: 'right', 'flex-end' }};
    --ws-mobile-justify: {{ section.settings.text_alignment_mobile | replace: 'left', 'flex-start' | replace: 'right', 'flex-end' }};
    --ws-padding-top: {{ section.settings.padding_top }}px;
    --ws-padding-bottom: {{ section.settings.padding_bottom }}px;
    --ws-mobile-top: {{ section.settings.padding_top_mobile }}px;
    --ws-mobile-bottom: {{ section.settings.padding_bottom_mobile }}px;
    {% if location_spacing %}
      padding-block: {{ section.settings.pad_mob }}px;
    {% endif %}
  }
  {% if location_spacing %}
    @media screen and (min-width: 768px) {
      #Wholesale-{{ section.id }} { padding-block: {{ section.settings.pad_tab }}px; }
    }
    @media screen and (min-width: 992px) {
      #Wholesale-{{ section.id }} { padding-block: {{ section.settings.pad_lap }}px; }
    }
    @media screen and (min-width: 1200px) {
      #Wholesale-{{ section.id }} { padding-block: {{ section.settings.pad_desk }}px; }
    }
  {% endif %}
{%- endstyle -%}
