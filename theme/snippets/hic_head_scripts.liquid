{% if request.page_type == 'product' %}
  <script src="{{ 'constants.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'pubsub.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'global.js' | asset_url }}" defer="defer"></script>
{% else %}
  <script type="lazyload2" data-src="{{ 'constants.js' | asset_url }}"></script>
  <script type="lazyload2" data-src="{{ 'pubsub.js' | asset_url }}"></script>
  <script type="lazyload2" data-src="{{ 'global.js' | asset_url }}"></script>
{% endif %}
{%- if settings.animations_reveal_on_scroll -%}
  <script type="lazyload2" data-src="{{ 'animations.js' | asset_url }}"></script>
{%- endif -%}