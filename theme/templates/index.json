            "heading_size": "ts-text-clamp_l"
          }
        },
        "text_QMpCCp": {
          "type": "text",
          "settings": {
            "text": "<p>At HEAL In COLOUR, we believe in the power of representation and inclusivity in every aspect of life. Our mission is to provide high-quality bandages that blend seamlessly with Black and Brown skin tones, ensuring that everyone feels seen and valued. Founded with a passion for diversity and healing, we are dedicated to creating products that honor the unique beauty of all skin tones.<br\/><br\/><em>Join us in our journey to make the world a more inclusive place, one bandage at a time.<\/em><\/p>",
            "text_style": "body",
            "use_color": false,
            "text_color": "rgba(0,0,0,0)"
          }
        },
        "button_JEECiN": {
