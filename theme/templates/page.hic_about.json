    "image_with_text_EEVWrw": {
      "type": "image-with-text",
      "blocks": {
        "heading_UadxbW": {
          "type": "heading",
          "settings": {
            "heading": "Our Story",
            "heading_size": "ts-text-clamp_l"
          }
        },
        "text_PezwrJ": {
          "type": "text",
          "settings": {
            "text": "<p>HEAL In COLOUR was founded with a simple yet powerful idea: to create bandages that truly reflect the diversity of our world. We noticed a lack of representation in wound care products and decided to take action. Our journey began with a passion for diversity and a commitment to providing high-quality, inclusive care solutions. Today, we are proud to offer products that make a difference in the lives of our customers.<\/p>",
            "text_style": "body",
            "use_color": true,
            "text_color": "#000000"
          }
        }
      },
