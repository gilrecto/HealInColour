{% render 'hic-wholesale-style', section: section %}
{%- liquid
  assign cta_link = section.settings.cta_url
  if section.settings.cta_type == 'email'
    assign cta_link = ''
    if section.settings.cta_email != blank
      assign email_address = section.settings.cta_email | strip | remove: 'mailto:' | url_encode | replace: '%40', '@'
      assign cta_link = 'mailto:' | append: email_address
    endif
  endif
-%}
<div id="Wholesale-{{ section.id }}" class="hic-wholesale color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="hic-wholesale__header">
        {%- if section.settings.eyebrow != blank -%}<p class="hic-wholesale__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="hic-wholesale__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      </div>
    {%- endif -%}
    {%- capture steps -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.number != blank or block.settings.title != blank or block.settings.description != blank -%}
          <li class="hic-wholesale__card" {{ block.shopify_attributes }}>
            {%- if block.settings.number != blank -%}<span class="hic-wholesale__number" aria-hidden="true">{{ block.settings.number | escape }}</span>{%- endif -%}
            {%- if block.settings.title != blank -%}<h3 class="hic-wholesale__card-heading">{{ block.settings.title | escape }}</h3>{%- endif -%}
            {%- if block.settings.description != blank -%}<div class="rte">{{ block.settings.description }}</div>{%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if steps != blank -%}<ol class="hic-wholesale__grid" role="list">{{ steps }}</ol>{%- endif -%}
    {%- if section.settings.cta_label != blank and cta_link != blank -%}
      <div class="hic-wholesale__actions hic-wholesale__order-actions">
        <a class="button hic-wholesale__button" href="{{ cta_link | escape }}">{{ section.settings.cta_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</div>

