{% if section.settings.quote != blank %}
  {% render 'hic-engage-style', section: section %}
  <div id="Engage-{{ section.id }}" class="hic-engage color-{{ section.settings.color_scheme }}">
    <div class="page-width">
      <figure class="hic-engage__quote-wrap">
        <blockquote class="hic-engage__quote">{{ section.settings.quote | escape | newline_to_br }}</blockquote>
        {% if section.settings.attribution != blank %}<figcaption class="hic-engage__eyebrow hic-engage__attribution">{{ section.settings.attribution | escape }}</figcaption>{% endif %}
      </figure>
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "[HIC] Founder quote",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote",
      "default": "“Representation belongs everywhere, even in the first aid kit.”"
    },
    {
      "type": "text",
      "id": "attribution",
      "label": "Attribution",
      "default": "Tianna McFarlane"
    },
    {
      "type": "header",
      "content": "Colours and typography"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-cc7267ca-e1da-41a9-85b9-cb71f3eb9260"
    },
    {
      "type": "paragraph",
      "content": "Optional colours inherit the selected theme scheme when empty. Check contrast after changing colours. Buttons use the theme scheme, with a contrasting foreground/background pair when its button contrast is too low."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background override"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text override"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading override"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent override"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Desktop heading size",
      "min": 28,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Mobile heading size",
      "min": 24,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body text size",
      "min": 14,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Layout and spacing"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Desktop text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "Mobile text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "class": "section",
  "presets": [
    {
      "name": "[HIC] Founder quote"
    }
  ]
}
{% endschema %}
