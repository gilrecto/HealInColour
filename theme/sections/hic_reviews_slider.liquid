			},
			{
				"type": "range",
				"id": "t_slides",
				"min": 1,
				"max": 6,
				"step": 1,
				"label": "Slides To Show Tablet",
				"default": 3
			},
			{
				"type": "range",
				"id": "m_slides",
				"min": 1,
				"max": 6,
				"step": 1,
				"label": "Slides To Show Mobile",
				"default": 2
			},
			{
				"type": "number",
				"id": "d_space",
				"label": "Space Between Slides",
				"default": 20,
				"info": "Desktop"
			},
			{
				"type": "number",
				"id": "l_space",
				"label": "Space Between Slides",
				"default": 20,
				"info": "Laptop"
			},
			{
				"type": "number",
				"id": "t_space",
				"label": "Space Between Slides",
				"default": 15,
				"info": "Tablet"
			},
			{
				"type": "number",
				"id": "m_space",
				"label": "Space Between Slides",
				"default": 10,
				"info": "Mobile"
			},
			{
				"type":"checkbox",
				"id":"enable_loop",
				"label": "Enable Loop",
				"default": true
			},
			{
				"type": "checkbox",
				"id": "mousewheel",
				"default": false,
				"label": "Enable Mousewheel Scroll"
			},
			{
				"type":"checkbox",
				"id":"enable_autoplay",
				"label": "Enable Autoplay",
				"default": true
			},
			{
				"type":"number",
				"id":"autoplay_speed",
				"label": "Autoplay Speed",
				"default": 5000
			},
			{
        "type": "header",
        "content": "Section spacing",
        "info": "Top and bottom padding"
      },
      {
        "type": "range",
        "id": "pad_desk",
        "label": "Dektop",
        "unit": "px",
        "min": 10,
        "max": 250,
        "step": 10,
        "default": 100,
				"info": "Padding"
      },
      {
        "type": "range",
        "id": "pad_lap",
        "label": "Laptop",
        "unit": "px",
        "min": 10,
        "max": 250,
        "step": 10,
        "default": 80,
				"info": "Padding"
      },
      {
        "type": "range",
        "id": "pad_tab",
        "label": "Tablet",
        "unit": "px",
        "min": 10,
        "max": 250,
        "step": 10,
        "default": 60,
				"info": "Padding"
      },
      {
        "type": "range",
        "id": "pad_mob",
        "label": "Mobile",
        "unit": "px",
        "min": 10,
        "max": 250,
        "step": 10,
        "default": 40,
				"info": "Padding"
      }
		],
		"blocks": [
			{
				"name": "Review",
				"type": "review",
				"settings": [
					{
						"type": "color_scheme",
						"id": "section_colors",
						"label": "Color Scheme",
						"default": "background-1"
					},
					{
						"type": "text",
						"id": "name",
