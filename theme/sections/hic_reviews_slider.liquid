				"content": "Background Image"
			},
			{
				"type": "checkbox",
				"id": "use_parallax",
				"label": "Parallax Background",
				"default": false,
				"info": "Add background image below to enable parallax effect."
			},
			{
				"type": "image_picker",
				"id": "bg_img",
				"label": "Background Image"
			},
			{
        "type": "inline_richtext",
        "id": "title",
        "label": "Section Heading",
				"default": "What Our Customer Says"
      },
      {
        "type": "richtext",
        "id": "body",
        "label": "Body Text"
      },
			{
				"type": "checkbox",
				"id": "show_review_count",
				"label": "Show Review Count",
				"default": true
			},
			{
				"type": "url",
				"id": "review_page_link",
				"label": "Reviews Page Link"
			},
			{
				"type":"header",
				"content":"Slider Settings"
			},
			{
				"type": "range",
