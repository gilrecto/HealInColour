		],
		"presets": [
      {
        "name":"[HIC] Reviews Slider",
        "category":"Custom Section",
        "blocks": [
          { "type": "review" },
          { "type": "review" },
          { "type": "review" },
          { "type": "review" },
          { "type": "review" }
