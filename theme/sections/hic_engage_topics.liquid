{% render 'hic-engage-style', section: section %}
<div id="Engage-{{ section.id }}" class="hic-engage color-{{ section.settings.color_scheme }}">
  <div class="page-width hic-engage__anchor"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}" tabindex="-1"{% endif %}>
    <div class="hic-engage__intro">
      {% if section.settings.eyebrow != blank %}<p class="hic-engage__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2 class="hic-engage__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
      {% if section.settings.description != blank %}<div class="rte">{{ section.settings.description }}</div>{% endif %}
    </div>
    {%- capture topics -%}
      {% for block in section.blocks %}
        {% if block.type == 'topic' %}
          {% if block.settings.title != blank or block.settings.description != blank or block.settings.audience != blank %}
            <article class="hic-engage__card" {{ block.shopify_attributes }}>
              {% if block.settings.number != blank %}<span class="hic-engage__number" aria-hidden="true">{{ block.settings.number | escape }}</span>{% endif %}
              {% if block.settings.title != blank %}<h3 class="hic-engage__card-heading ">{{ block.settings.title | escape }}</h3>{% endif %}
              {% if block.settings.description != blank %}<div class="rte">{{ block.settings.description }}</div>{% endif %}
              {% if block.settings.audience != blank %}<p class="hic-engage__audience">{{ block.settings.audience | escape }}</p>{% endif %}
            </article>
          {% endif %}
        {% endif %}
      {% endfor %}
    {%- endcapture -%}
    {% if topics != blank %}<div class="hic-engage__grid">{{ topics }}</div>{% endif %}
    {%- capture formats -%}
      {% for block in section.blocks %}
        {% if block.type == 'format' %}
          {% if block.settings.title != blank or block.settings.description != blank %}
            <div {{ block.shopify_attributes }}>
              {% if block.settings.title != blank %}<h3 class="hic-engage__card-heading">{{ block.settings.title | escape }}</h3>{% endif %}
              {% if block.settings.description != blank %}<div class="rte">{{ block.settings.description }}</div>{% endif %}
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
    {%- endcapture -%}
    {% if formats != blank %}<div class="hic-engage__grid hic-engage__formats">{{ formats }}</div>{% endif %}
  </div>
</div>

