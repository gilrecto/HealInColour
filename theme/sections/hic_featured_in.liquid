{% assign setting = section.settings %}
{% liquid
	assign desktop_pad_top = setting.pad_desk_top
    assign desktop_pad_btm = setting.pad_desk_btm
	assign laptop_pad_top = setting.pad_lap_top
	assign laptop_pad_btm = setting.pad_lap_btm
	assign tablet_pad_top = setting.pad_tab_top
	assign tablet_pad_btm = setting.pad_tab_btm
	assign mobile_pad_top = setting.pad_mob_top
	assign mobile_pad_btm = setting.pad_mob_btm
%}

{%- style -%}
	#shopify-section-{{ section.id }} .featured-in {
		padding-top: {{ mobile_pad_top | append: 'px'}};
        padding-bottom: {{ mobile_pad_btm | append: 'px'}};
	}

	@media only screen and (min-width: 768px) {
		#shopify-section-{{ section.id }} .featured-in {
    		padding-top: {{ tablet_pad_top | append: 'px'}};
            padding-bottom: {{ tablet_pad_btm | append: 'px'}};
		}
	}

	@media only screen and (min-width: 992px) {
		#shopify-section-{{ section.id }} .featured-in {
            padding-top: {{ laptop_pad_top | append: 'px'}};
            padding-bottom: {{ laptop_pad_btm | append: 'px'}};
		}
	}
	
	@media only screen and (min-width: 1200px) {
		#shopify-section-{{ section.id }} .featured-in {
            padding-top: {{ desktop_pad_top | append: 'px'}};
            padding-bottom: {{ desktop_pad_btm | append: 'px'}};
		}
	}
{%- endstyle -%}

<div class="featured-in color-{{ setting.section_colors }}">
	<div class="page-width ts-max-w-[145rem]">
		{%- if setting.heading != blank or setting.subheading != blank -%}
			<div class="title-area {{ setting.alignment }} lg:ts-mb-20 md:ts-mb-16 ts-mb-12">
				<h2 class="section__heading inline-richtext {{ setting.heading_size }} ts-leading-[1.1] ts-m-0 ts-mb-6">
					{{ setting.heading }}
				</h2>
				{%- if setting.subheading != blank -%}
					<div class="rte ts-text-dark">
						{{ setting.subheading }}
					</div>
				{%- endif -%}
			</div>
		{%- endif -%}
		{%- if section.blocks.size > 0 -%}
			<div class="logo-grid ts-grid lg:ts-gap-[4.5rem] md:ts-gap-12 ts-gap-10 ts-items-center ts-flex-wrap lg:ts-grid-cols-9 md:ts-grid-cols-6 ts-grid-cols-3 ts-grid-flow-row">
				{%- for block in section.blocks -%}
					<div class="logo-grid-item ts-relative">
						{%- if block.settings.link != blank -%}
							<a href="{{ block.settings.link }}" class="link-to"{% if block.settings.new_tab %} target="_blank"{% endif %}>Link To</a>
						{%- endif -%}
						{%- assign image = block.settings.image -%}
						{% render 'image', image: image, section: section %}
					</div>
				{%- endfor -%}
			</div>
		{%- endif -%}
	</div>
</div>

{% schema %}
	{
		"name": "[HIC] Featured In",
		"class": "hic-featured-in",
		"tag": "section",
		"settings": [
			{
				"type": "color_scheme",
				"id": "section_colors",
				"label": "Section Color Scheme",
				"default": "background-1"
			},
			{
				"type": "inline_richtext",
				"id": "heading",
				"default": "Featured In:",
				"label": "t:sections.image-banner.blocks.heading.settings.heading.label"
			},
			{
				"type": "select",
				"id": "heading_size",
				"options": [
					{
						"value": "h2",
						"label": "t:sections.all.heading_size.options__1.label"
					},
					{
						"value": "h1",
						"label": "t:sections.all.heading_size.options__2.label"
					},
					{
						"value": "ts-text-clamp_l",
						"label": "t:sections.all.heading_size.options__3.label"
					},
					{
						"value": "ts-text-clamp_xl",
						"label": "t:sections.all.heading_size.options__4.label"
					},
					{
						"value": "ts-text-clamp_xxl",
						"label": "t:sections.all.heading_size.options__5.label"
					}
				],
				"default": "h1",
				"label": "t:sections.all.heading_size.label"
			},
			{
				"type": "richtext",
				"id": "subheading",
				"label": "Subtext"
			},
			{
				"type": "select",
				"id": "alignment",
				"label": "Text alignment",
				"options": [
					{
						"value": "ts-text-left",
						"label": "Left"
					},
					{
						"value": "ts-text-center",
						"label": "Center"
					},
					{
						"value": "ts-text-right",
						"label": "Right"
					}
				],
				"default": "ts-text-center"
			},
			{
				"type": "header",
				"content": "Section spacing",
				"info": "Top and bottom padding"
			},
			{
				"type": "range",
				"id": "pad_desk_top",
				"label": "Dektop",
				"unit": "px",
				"min": 10,
				"max": 250,
				"step": 10,
				"default": 10,
				"info": "Padding Top"
			},
			{
				"type": "range",
				"id": "pad_desk_btm",
				"label": "Dektop",
				"unit": "px",
				"min": 10,
				"max": 250,
				"step": 10,
				"default": 10,
				"info": "Padding Bottom"
			},
			{
				"type": "range",
				"id": "pad_lap_top",
				"label": "Laptop",
				"unit": "px",
				"min": 10,
				"max": 250,
				"step": 10,
				"default": 10,
				"info": "Padding Top"
			},
			{
				"type": "range",
				"id": "pad_lap_btm",
				"label": "Laptop",
				"unit": "px",
				"min": 10,
				"max": 250,
				"step": 10,
				"default": 10,
				"info": "Padding Bottom"
			},
			{
				"type": "range",
				"id": "pad_tab_top",
				"label": "Tablet",
				"unit": "px",
				"min": 10,
				"max": 250,
				"step": 10,
				"default": 10,
				"info": "Padding Top"
			},
			{
				"type": "range",
				"id": "pad_tab_btm",
				"label": "Tablet",
				"unit": "px",
				"min": 10,
				"max": 250,
				"step": 10,
				"default": 10,
				"info": "Padding Bottom"
			},
			{
				"type": "range",
				"id": "pad_mob_top",
				"label": "Mobile",
				"unit": "px",
				"min": 10,
				"max": 250,
				"step": 10,
				"default": 10,
				"info": "Padding Top"
			},
            {
				"type": "range",
				"id": "pad_mob_btm",
				"label": "Mobile",
				"unit": "px",
				"min": 10,
				"max": 250,
				"step": 10,
				"default": 10,
				"info": "Padding Bottom"
			}
		],
		"blocks": [
			{
				"type": "logo_img",
				"name": "Company Logo",
				"settings": [
					{
						"type": "image_picker",
						"id": "image",
						"label": "Logo Image"
					},
					{
						"type": "url",
						"id": "link",
						"label": "Link To"
					},
					{
						"type": "checkbox",
						"id": "new_tab",
						"label": "New Tab",
						"default": false,
						"info": "Open link in separate tab."
					}
				]
			}
		],
		"presets": [
			{
				"name":"[HIC] Featured In",
				"settings": {}
			}
		]
	}
{% endschema %}
