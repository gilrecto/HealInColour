{% render 'hic-wholesale-style', section: section %}
{%- liquid
  assign benefits = section.blocks | where: 'type', 'benefit'
  assign audiences = section.blocks | where: 'type', 'audience'
-%}
<div id="Wholesale-{{ section.id }}" class="hic-wholesale color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="hic-wholesale__header">
        {%- if section.settings.eyebrow != blank -%}<p class="hic-wholesale__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="hic-wholesale__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      </div>
    {%- endif -%}
    {%- capture benefit_cards -%}
      {%- for block in benefits -%}
        {%- if block.settings.title != blank or block.settings.description != blank or block.settings.icon != blank -%}
          <li class="hic-wholesale__card hic-wholesale__benefit" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != blank -%}
              {{ block.settings.icon | image_url: width: 120 | image_tag: widths: '40, 80, 120', sizes: '40px', alt: '', class: 'hic-wholesale__icon' }}
            {%- endif -%}
            {%- if block.settings.title != blank -%}<h3 class="hic-wholesale__card-heading">{{ block.settings.title | escape }}</h3>{%- endif -%}
            {%- if block.settings.description != blank -%}<div class="rte">{{ block.settings.description }}</div>{%- endif -%}
          </li>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if benefit_cards != blank -%}<ul class="hic-wholesale__grid" role="list">{{ benefit_cards }}</ul>{%- endif -%}
    {%- capture audience_chips -%}
      {%- for block in audiences -%}
        {%- if block.settings.title != blank -%}<li class="hic-wholesale__chip" {{ block.shopify_attributes }}>{{ block.settings.title | escape }}</li>{%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if audience_chips != blank -%}
      <div class="hic-wholesale__audiences">
        {%- if section.settings.audience_heading != blank -%}<h3 class="hic-wholesale__audience-heading">{{ section.settings.audience_heading | escape }}</h3>{%- endif -%}
        <ul class="hic-wholesale__chips" role="list">{{ audience_chips }}</ul>
      </div>
    {%- endif -%}
  </div>
</div>

