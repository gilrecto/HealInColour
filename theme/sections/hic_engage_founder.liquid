{% render 'hic-engage-style', section: section %}
<div id="Engage-{{ section.id }}" class="hic-engage color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="hic-engage__split hic-engage__split--founder{% if section.settings.image != blank %} hic-engage__split--with-image{% endif %} hic-engage__split--{{ section.settings.mobile_layout }}">
      <div class="hic-engage__copy">
        {% if section.settings.eyebrow != blank %}<p class="hic-engage__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        {% if section.settings.name != blank %}<h2 class="hic-engage__heading">{{ section.settings.name | escape }}</h2>{% endif %}
        {% if section.settings.title != blank %}<p class="hic-engage__title">{{ section.settings.title | escape }}</p>{% endif %}
        {% if section.settings.biography != blank %}<div class="rte">{{ section.settings.biography }}</div>{% endif %}
        {%- capture achievements -%}
          {% for block in section.blocks %}
            {% if block.settings.title != blank or block.settings.description != blank %}
              <div class="hic-engage__card" {{ block.shopify_attributes }}>
                {% if block.settings.title != blank %}<h3 class="hic-engage__card-heading">{{ block.settings.title | escape }}</h3>{% endif %}
                {% if block.settings.description != blank %}<div class="rte">{{ block.settings.description }}</div>{% endif %}
              </div>
            {% endif %}
          {% endfor %}
        {%- endcapture -%}
        {% if achievements != blank %}<div class="hic-engage__grid hic-engage__recognition">{{ achievements }}</div>{% endif %}
        {%- capture actions -%}
          {% if section.settings.primary_label != blank and section.settings.primary_link != blank %}<a class="button hic-engage__button" href="{{ section.settings.primary_link | escape }}">{{ section.settings.primary_label | escape }}</a>{% endif %}
          {% if section.settings.secondary_label != blank and section.settings.secondary_link != blank %}<a class="button button--secondary hic-engage__button" href="{{ section.settings.secondary_link | escape }}">{{ section.settings.secondary_label | escape }}</a>{% endif %}
        {%- endcapture -%}
        {% if actions != blank %}<div class="hic-engage__actions">{{ actions }}</div>{% endif %}
      </div>
      {% render 'hic-engage-image', section: section %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "[HIC] Meet the founder",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Meet the founder"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Founder name",
      "default": "Tianna McFarlane"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Founder title",
      "default": "Award-winning entrepreneur · Founder & CEO"
    },
    {
      "type": "richtext",
      "id": "biography",
      "label": "Biography",
      "default": "<p>Tianna McFarlane is an award-winning entrepreneur and the founder of Heal In Colour, Canada’s first inclusive bandage brand.</p><p>The idea started with a simple moment. Tianna cut her knee, went looking for a bandage that matched her skin, and couldn’t find one. So she built the solution herself. She launched Heal In Colour in April 2021, and it’s now sold in Loblaws stores across Canada and used by school boards, universities and workplaces nationwide.</p><p>In a rare honour, Heal In Colour’s prototypes and products were preserved by <a href=\"https://collection.ingenium.ca/en/search/?q=heal+in+colour&type=all&sort=score_des&page=1\" title=\"https://collection.ingenium.ca/en/search/?q=heal+in+colour&type=all&sort=score_des&page=1\">Ingenium, Canada’s National Science and Technology collection centre</a>, for their significance to Canadian history.</p><p>Tianna’s work has earned national recognition. She is the 2026 recipient of the George Weston Entrepreneurship Award, presented by the BlackNorth Initiative, and has been named a Toronto Star Changemaker.&nbsp;</p><p>Tianna’s message is simple: representation belongs everywhere, even in the first aid kit.</p>"
    },
    {
      "type": "paragraph",
      "content": "Client verification required: Canada’s first claim, launch date, distribution, Ingenium, George Weston/BlackNorth award, Toronto Star Changemaker, CSB100 and Dragons’ Den appearance/date. Reference copy is editable and is not independently verified."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Founder image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alternative text",
      "info": "Describe the image. If empty, the image library alternative text is used."
    },
    {
      "type": "text",
      "id": "caption",
      "label": "Image caption"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Original image"
        },
        {
          "value": "3/4",
          "label": "Portrait 3:4"
        },
        {
          "value": "1/1",
          "label": "Square"
        },
        {
          "value": "4/5",
          "label": "Portrait 4:5"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "mobile_layout",
      "label": "Mobile layout",
      "options": [
        {
          "value": "text-first",
          "label": "Text first"
        },
        {
          "value": "image-first",
          "label": "Image first"
        }
      ],
      "default": "text-first"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
