{% render 'hic-engage-style', section: section %}
{%- assign form_id = 'EngageContact-' | append: section.id -%}
{%- assign form_label = section.settings.form_heading | default: section.settings.heading | default: 'Booking enquiry' -%}
<div id="Engage-{{ section.id }}" class="hic-engage color-{{ section.settings.color_scheme }}">
  <div class="page-width hic-engage__anchor"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}" tabindex="-1"{% endif %}>
    <div class="hic-engage__split hic-engage__split--booking">
      <div class="hic-engage__copy">
        {% if section.settings.eyebrow != blank %}<p class="hic-engage__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
        {% if section.settings.heading != blank %}<h2 class="hic-engage__heading">{{ section.settings.heading | escape }}</h2>{% endif %}
        {% if section.settings.description != blank %}<div class="rte">{{ section.settings.description }}</div>{% endif %}
        {%- capture benefits -%}
          {% for block in section.blocks %}
            {% if block.type == 'benefit' and block.settings.text != blank %}<li {{ block.shopify_attributes }}><span class="hic-engage__check" aria-hidden="true">&#10003;</span><span>{{ block.settings.text | escape }}</span></li>{% endif %}
          {% endfor %}
        {%- endcapture -%}
        {% if benefits != blank %}<ul class="hic-engage__checklist" role="list">{{ benefits }}</ul>{% endif %}
      </div>
      <div class="hic-engage__form-panel color-{{ section.settings.form_color_scheme }}">
        {% if section.settings.form_heading != blank %}<h3 class="hic-engage__card-heading" id="{{ form_id }}-heading">{{ section.settings.form_heading | escape }}</h3>{% endif %}
        {%- form 'contact', id: form_id, class: 'hic-engage__form', aria-label: form_label, data-shopify-captcha: 'true' -%}
          {% if form.posted_successfully? %}
            <div class="hic-engage__status" role="status" tabindex="-1" autofocus>{{ section.settings.success_message | default: 'Thank you. Your enquiry has been sent.' | escape }}</div>
          {% elsif form.errors %}
            <div class="hic-engage__status" role="alert" tabindex="-1" autofocus>
              <p>{{ section.settings.error_heading | default: 'Please correct the following errors:' | escape }}</p>
              <ul role="list">
                {% for error in form.errors %}
                  <li>
                    {% if error == 'form' %}
                      {{ form.errors.messages[error] }}
                    {% else %}
                      <a href="#{{ form_id }}-{{ error | handleize }}">{{ form.errors.translated_fields[error] | capitalize | escape }} {{ form.errors.messages[error] | escape }}</a>
                    {% endif %}
                  </li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}
          {% if section.settings.required_note != blank %}<p>{{ section.settings.required_note | escape }}</p>{% endif %}
          <div class="hic-engage__form-fields">
            {%- assign fields = 'name,email,organization,event_date' | split: ',' -%}
            {% for field in fields %}
              {%- liquid
                assign label_key = field | append: '_label'
                assign placeholder_key = field | append: '_placeholder'
                assign input_type = 'text'
                assign autocomplete = 'off'
                assign label = section.settings[label_key]
                assign value = form[field]
                case field
                  when 'name'
                    assign autocomplete = 'name'
                    assign value = form.name | default: customer.name
                    assign label = label | default: 'Full name'
                  when 'email'
                    assign input_type = 'email'
                    assign autocomplete = 'email'
                    assign value = form.email | default: customer.email
                    assign label = label | default: 'Email'
                  when 'organization'
                    assign autocomplete = 'organization'
                    assign label = label | default: 'Organization'
                  when 'event_date'
                    assign input_type = 'date'
                    assign label = label | default: 'Event date'
                endcase
              -%}
              <div class="hic-engage__field">
                <label for="{{ form_id }}-{{ field | handleize }}">{{ label | escape }}{% if field == 'name' or field == 'email' %} <span aria-hidden="true">*</span>{% endif %}</label>
                <input class="hic-engage__input" type="{{ input_type }}" id="{{ form_id }}-{{ field | handleize }}" name="contact[{{ field }}]" autocomplete="{{ autocomplete }}" value="{{ value | escape }}"
                  {% if input_type != 'date' %}placeholder="{{ section.settings[placeholder_key] | escape }}"{% endif %}
                  {% if field == 'name' or field == 'email' %}required aria-required="true"{% endif %}
                  {% if field == 'email' %}spellcheck="false" autocapitalize="off"{% endif %}
                  {% if form.errors contains field %}aria-invalid="true" aria-describedby="{{ form_id }}-{{ field | handleize }}-error"{% endif %}>
                {% if form.errors contains field %}<small class="hic-engage__error" id="{{ form_id }}-{{ field | handleize }}-error">{{ form.errors.messages[field] | escape }}</small>{% endif %}
              </div>
            {% endfor %}
            {%- capture engagement_options -%}
              {% for block in section.blocks %}
                {% if block.type == 'engagement' and block.settings.label != blank %}
                  <option value="{{ block.settings.label | escape }}"{% if form.engagement_type == block.settings.label %} selected{% endif %} {{ block.shopify_attributes }}>{{ block.settings.label | escape }}</option>
                {% endif %}
              {% endfor %}
            {%- endcapture -%}
            {% if engagement_options != blank %}
              <div class="hic-engage__field hic-engage__field--wide">
                <label for="{{ form_id }}-engagement-type">{{ section.settings.engagement_label | default: 'Engagement type' | escape }}</label>
                <select class="hic-engage__input" id="{{ form_id }}-engagement-type" name="contact[engagement_type]">
                  <option value="">{{ section.settings.engagement_placeholder | escape }}</option>
                  {{ engagement_options }}
                </select>
              </div>
            {% endif %}
            <div class="hic-engage__field hic-engage__field--wide">
              <label for="{{ form_id }}-body">{{ section.settings.message_label | default: 'Event details' | escape }} <span aria-hidden="true">*</span></label>
              <textarea class="hic-engage__input" id="{{ form_id }}-body" name="contact[body]" rows="6" required aria-required="true" placeholder="{{ section.settings.message_placeholder | escape }}"{% if form.errors contains 'body' %} aria-invalid="true" aria-describedby="{{ form_id }}-body-error"{% endif %}>{{ form.body | escape }}</textarea>
              {% if form.errors contains 'body' %}<small class="hic-engage__error" id="{{ form_id }}-body-error">{{ form.errors.messages.body | escape }}</small>{% endif %}
            </div>
          </div>
          <button type="submit" class="button hic-engage__button">{{ section.settings.button_label | default: 'Send request' | escape }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
